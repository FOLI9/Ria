    g_hDevice = OpenHid(path);
    if (g_hDevice == INVALID_HANDLE_VALUE) { printf("Open failed\n"); getchar(); return 1; }

    // Установить красный цвет (R=255 G=0 B=0) через фичу 0x0e (0x8071 RGB Effects)
    const BYTE F = 0x0e;
    std::vector<BYTE> resp;

    printf("=== Пробуем функцию 1 с разными вариантами ===\n\n");

    // Вариант A: z=0, effect=1, persist=0, R, G, B (как мы пробовали для func 3)
    printf("[A] func 1: [00 01 00 ff 00 00]\n");
    HidppWrite(g_hDevice, F, 0x01, {0x00, 0x01, 0x00, 0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    // Вариант B: z=0, effect=1, R, G, B (без persistence)
    printf("\n[B] func 1: [00 01 ff 00 00]\n");
    HidppWrite(g_hDevice, F, 0x01, {0x00, 0x01, 0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    // Вариант C: z=0, R, G, B (только цвет)
    printf("\n[C] func 1: [00 ff 00 00]\n");
    HidppWrite(g_hDevice, F, 0x01, {0x00, 0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    // Вариант D: только R G B
    printf("\n[D] func 1: [ff 00 00]\n");
    HidppWrite(g_hDevice, F, 0x01, {0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    // Вариант E: с параметром 0xf2 0xe2 как у G HUB
    printf("\n[E] func 1: [00 00 f2 e2 ff 00 00] (как у G HUB)\n");
    HidppWrite(g_hDevice, F, 0x01, {0x00, 0x00, 0xF2, 0xE2, 0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    printf("\n=== Пробуем функцию 6 ===\n\n");

    // Вариант F: как G HUB
    printf("[F] func 6: [00 00 f2 e2 00 00 00]\n");
    HidppWrite(g_hDevice, F, 0x06, {0x00, 0x00, 0xF2, 0xE2, 0x00, 0x00, 0x00}, resp);
    Sleep(500);

    // Вариант G: с цветом
    printf("\n[G] func 6: [00 00 f2 e2 ff 00 00]\n");
    HidppWrite(g_hDevice, F, 0x06, {0x00, 0x00, 0xF2, 0xE2, 0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    printf("\n=== Пробуем функцию 3 (эта давала ошибку 0x02) ===\n\n");
    printf("[H] func 3: [00 01 00 ff 00 00]\n");
    HidppWrite(g_hDevice, F, 0x03, {0x00, 0x01, 0x00, 0xFF, 0x00, 0x00}, resp);
    Sleep(500);

    printf("\n=== Смотрим что у нас в других функциях ===\n\n");
    printf("[I] func 0 (GetZoneCount):\n");
    HidppWrite(g_hDevice, F, 0x00, {}, resp);
    Sleep(300);

    printf("\n[J] func 2 (GetZoneEffect?):\n");
    HidppWrite(g_hDevice, F, 0x02, {0x00}, resp);
    Sleep(300);

    CloseHandle(g_hDevice);

    printf("\n=== СМОТРИ НА МЫШЬ! ===\n");
    printf("Если цвет поменялся после какого-то варианта — запиши, какого.\n");
    printf("Особенно смотри варианты D, E, G.\n");
    printf("\nPress Enter...\n");
