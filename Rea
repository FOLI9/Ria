// led_test3.cpp — SET_REPORT Output (как G HUB)
#include <windows.h>
#include <setupapi.h>
#include <hidsdi.h>
#include <hidpi.h>
#include <cstdio>
#include <vector>
#include <string>

#pragma comment(lib, "setupapi.lib")
#pragma comment(lib, "hid.lib")

HANDLE g_hDevice = INVALID_HANDLE_VALUE;

HANDLE OpenHid(const std::wstring& path) {
    return CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE,
        FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
        FILE_FLAG_OVERLAPPED, nullptr);
}

bool HidRead(HANDLE h, std::vector<BYTE>& buf, DWORD ms) {
    OVERLAPPED ov{}; ov.hEvent = CreateEvent(nullptr, TRUE, FALSE, nullptr);
    DWORD r = 0;
    BOOL ok = ReadFile(h, buf.data(), (DWORD)buf.size(), &r, &ov);
    if (!ok && GetLastError() != ERROR_IO_PENDING) { CloseHandle(ov.hEvent); return false; }
    if (WaitForSingleObject(ov.hEvent, ms) != WAIT_OBJECT_0) { CancelIo(h); CloseHandle(ov.hEvent); return false; }
    ok = GetOverlappedResult(h, &ov, &r, FALSE); buf.resize(r); CloseHandle(ov.hEvent); return ok;
}

void ReadResp(const char* label) {
    std::vector<BYTE> resp(20);
    if (HidRead(g_hDevice, resp, 500)) {
        printf("%s", label);
        for (BYTE b : resp) printf("%02x ", b);
        printf("\n");
    } else {
        printf("%s (no data)\n", label);
    }
}

bool SendOutput(BYTE featureIdx, BYTE func, const std::vector<BYTE>& args) {
    std::vector<BYTE> req(20, 0);
    req[0] = 0x11;
    req[1] = 0xFF;
    req[2] = featureIdx;
    req[3] = (BYTE)((func << 4) | 0x01);
    for (size_t i = 0; i < args.size() && i < 16; ++i) req[4 + i] = args[i];

    printf("    >> ");
    for (BYTE b : req) printf("%02x ", b);
    printf("\n");

    if (!HidD_SetOutputReport(g_hDevice, req.data(), 20)) {
        printf("    SetOutputReport FAILED (err=%lu)\n", GetLastError());
        return false;
    }
    printf("    (sent OK)\n");
    return true;
}

std::wstring FindHidpp(USHORT vid, USHORT* outPid) {
    GUID g; HidD_GetHidGuid(&g);
    HDEVINFO di = SetupDiGetClassDevs(&g, nullptr, nullptr, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
    if (di == INVALID_HANDLE_VALUE) return {};
    SP_DEVICE_INTERFACE_DATA id{}; id.cbSize = sizeof(id);
    std::wstring found;
    for (DWORD i = 0; SetupDiEnumDeviceInterfaces(di, nullptr, &g, i, &id); ++i) {
        DWORD need = 0;
        SetupDiGetDeviceInterfaceDetail(di, &id, nullptr, 0, &need, nullptr);
        if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) continue;
        std::vector<BYTE> buf(need);
        auto* d = reinterpret_cast<PSP_DEVICE_INTERFACE_DETAIL_DATA>(buf.data());
        d->cbSize = sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA);
        if (!SetupDiGetDeviceInterfaceDetail(di, &id, d, need, nullptr, nullptr)) continue;
        std::wstring p = d->DevicePath;
        HANDLE h = CreateFileW(p.c_str(), GENERIC_READ | GENERIC_WRITE,
                               FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, 0, nullptr);
        if (h == INVALID_HANDLE_VALUE) continue;
        HIDD_ATTRIBUTES at{}; at.Size = sizeof(at);
        if (HidD_GetAttributes(h, &at) && at.VendorID == vid) {
            PHIDP_PREPARSED_DATA pp = nullptr;
            if (HidD_GetPreparsedData(h, &pp)) {
                HIDP_CAPS c{};
                if (HidP_GetCaps(pp, &c) == HIDP_STATUS_SUCCESS &&
                    c.InputReportByteLength >= 20 && c.OutputReportByteLength >= 20) {
                    found = p; if (outPid) *outPid = at.ProductID;
                }
                HidD_FreePreparsedData(pp);
            }
        }
        CloseHandle(h);
        if (!found.empty()) break;
    }
    SetupDiDestroyDeviceInfoList(di);
    return found;
}

int main() {
    printf("=== LED Test v3: SET_REPORT Output ===\n\n");

    USHORT pid = 0;
    std::wstring path = FindHidpp(0x046d, &pid);
    if (path.empty()) { printf("not found\n"); getchar(); return 1; }
    printf("Found PID=0x%04x\n", pid);

    g_hDevice = OpenHid(path);
    if (g_hDevice == INVALID_HANDLE_VALUE) { printf("open failed\n"); getchar(); return 1; }

    const BYTE F = 0x0e;

    printf("\n### 1. func 6 (как G HUB): [00 00 f2 e2 00 00 00] ###\n");
    SendOutput(F, 0x06, {0x00, 0x00, 0xF2, 0xE2, 0x00, 0x00, 0x00});
    Sleep(100);
    ReadResp("    << ");

    printf("\n### 2. func 1 (как G HUB): [00 00 f2 e2 00 00 00] ###\n");
    SendOutput(F, 0x01, {0x00, 0x00, 0xF2, 0xE2, 0x00, 0x00, 0x00});
    Sleep(100);
    ReadResp("    << ");

    printf("\n>>> Цвет изменился? Enter...\n");
    getchar();

    printf("\n### 3. func 6 + func 1, красный (ff 00 00) ###\n");
    SendOutput(F, 0x06, {0x00, 0x00, 0xF2, 0xE2, 0xFF, 0x00, 0x00});
    Sleep(200);
    ReadResp("    << ");
    SendOutput(F, 0x01, {0x00, 0x00, 0xF2, 0xE2, 0xFF, 0x00, 0x00});
    Sleep(200);
    ReadResp("    << ");

    printf("\n>>> Мышь КРАСНАЯ? Enter...\n");
    getchar();

    printf("\n### 4. func 1: [00 01 FF 00 00] ###\n");
    SendOutput(F, 0x01, {0x00, 0x01, 0xFF, 0x00, 0x00});
    Sleep(200);
    ReadResp("    << ");

    printf("\n### 5. func 1: [00 01 00 FF 00 00] ###\n");
    SendOutput(F, 0x01, {0x00, 0x01, 0x00, 0xFF, 0x00, 0x00});
    Sleep(200);
    ReadResp("    << ");

    printf("\n>>> Мышь КРАСНАЯ? Enter...\n");
    getchar();

    printf("\n### 6. func 1: [00 FF 00 00] ###\n");
    SendOutput(F, 0x01, {0x00, 0xFF, 0x00, 0x00});
    Sleep(200);
    ReadResp("    << ");

    printf("\n### 7. func 1 синий: [00 00 F2 E2 00 00 FF] ###\n");
    SendOutput(F, 0x01, {0x00, 0x00, 0xF2, 0xE2, 0x00, 0x00, 0xFF});
    Sleep(200);
    ReadResp("    << ");

    printf("\n>>> Мышь СИНЯЯ? Enter...\n");
    getchar();

    CloseHandle(g_hDevice);
    printf("\nDone.\n");
    getchar();
    return 0;
}
