// g102_test — консольная утилита для проверки связи с Logitech G102/G203
// через HID++ (interface 1, endpoint 0x82).
//
// Сборка:
//   mkdir build && cd build
//   cmake .. -DCMAKE_BUILD_TYPE=Release
//   cmake --build .
//
// Запуск:
//   ./g102_test                 // interface=1, любой serial
//   ./g102_test 0               // interface=0 (мышь, boot protocol)
//   ./g102_test 1 162AE4510D14  // interface=1 + конкретный serial

#include <hidapi/hidapi.h>

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <optional>
#include <stdexcept>
#include <string>
#include <vector>

static constexpr uint16_t VID = 0x046D;   // Logitech
static constexpr uint16_t PID = 0xC092;   // G102 / G203 LIGHTSYNC

// ---------- helpers ----------

static void print_hex(const char* label,
                      const std::vector<uint8_t>& data)
{
    std::printf("%s (%zu bytes): ", label, data.size());
    for (auto b : data) std::printf("%02X ", b);
    std::printf("\n");
}

static void list_devices()
{
    std::printf("-- Поиск Logitech %04X:%04X --\n", VID, PID);

    hid_device_info* list = hid_enumerate(VID, PID);
    if (!list) {
        std::printf("Устройство не найдено.\n");
        return;
    }

    for (hid_device_info* d = list; d; d = d->next) {
        std::printf("  path=%ls\n", d->path);
        std::printf("    interface_number = %d\n", d->interface_number);
        std::printf("    usage_page       = 0x%04X\n", d->usage_page);
        std::printf("    usage            = 0x%04X\n", d->usage);
        std::printf("    serial           = %ls\n",
                    d->serial_number ? d->serial_number : L"(нет)");
        std::printf("    manufacturer     = %ls\n",
                    d->manufacturer_string ? d->manufacturer_string : L"(нет)");
        std::printf("    product          = %ls\n",
                    d->product_string ? d->product_string : L"(нет)");
    }
    hid_free_enumeration(list);
    std::printf("--\n\n");
}

// ---------- открытие ----------

static hid_device* open_g102(int interface,
                             const std::optional<std::string>& serial)
{
    hid_device_info* list = hid_enumerate(VID, PID);
    if (!list) throw std::runtime_error("G102 не найдена (hid_enumerate)");

    hid_device* dev = nullptr;

    for (hid_device_info* d = list; d; d = d->next) {
        // На Windows hidapi иногда возвращает -1 для interface_number,
        // тогда fallback'ом считаем, что это interface 0 (boot mouse).
        bool iface_ok = (d->interface_number == interface) ||
                        (d->interface_number == -1 && interface == 0);

        bool serial_ok = true;
        if (serial) {
            if (!d->serial_number) {
                serial_ok = false;
            } else {
                // serial_number — wchar_t*, сравниваем через string
                std::wstring w(d->serial_number);
                std::string s(w.begin(), w.end());
                serial_ok = (s == *serial);
            }
        }

        if (iface_ok && serial_ok) {
            dev = hid_open_path(d->path);
            if (dev) break;
        }
    }

    hid_free_enumeration(list);

    if (!dev)
        throw std::runtime_error("Не удалось открыть G102 (interface " +
                                 std::to_string(interface) + ")");

    hid_set_nonblocking(dev, 1);
    return dev;
}

// ---------- чтение / запись ----------

static std::vector<uint8_t> read_report(hid_device* dev, int timeout_ms)
{
    std::vector<uint8_t> buf(64, 0);
    int n = hid_read_timeout(dev, buf.data(), buf.size(), timeout_ms);
    if (n <= 0) return {};
    buf.resize(n);
    return buf;
}

static void write_report(hid_device* dev,
                         const std::vector<uint8_t>& data)
{
    if (hid_write(dev, data.data(), data.size()) < 0)
        throw std::runtime_error("hid_write() failed");
}

// ---------- HID++ ----------

// report_id: 0x10 (short, 7 байт) или 0x11 (long, 20 байт)
static void hidpp_send(hid_device* dev,
                       uint8_t report_id,
                       uint8_t device_index,
                       uint8_t feature_index,
                       uint8_t function,
                       const std::vector<uint8_t>& params = {})
{
    size_t size = (report_id == 0x10) ? 7 : 20;

    std::vector<uint8_t> pkt(size, 0);
    pkt[0] = report_id;
    pkt[1] = device_index;
    pkt[2] = feature_index;
    pkt[3] = function;

    for (size_t i = 0; i < params.size() && (4 + i) < size; ++i)
        pkt[4 + i] = params[i];

    write_report(dev, pkt);
}

// Ping через root feature (feature index 0x00, function 0x01).
// Ответ: 10 FF 00 01 00 00 00 (успех) или ... 01 ... (ошибка).
static bool hidpp_ping(hid_device* dev)
{
    std::printf(">> HID++ ping (root feature 0x00, function 0x01)\n");
    hidpp_send(dev, 0x10, 0xFF, 0x00, 0x01);

    auto resp = read_report(dev, 500);
    if (resp.empty()) {
        std::printf("<< ответа нет\n");
        return false;
    }

    print_hex("<<", resp);

    if (resp.size() >= 5 && resp[0] == 0x10 && resp[2] == 0x00) {
        if (resp[4] == 0x00) {
            std::printf("   ping OK\n");
            return true;
        }
        std::printf("   ping вернул код ошибки 0x%02X\n", resp[4]);
        return false;
    }
    std::printf("   неожиданный ответ\n");
    return false;
}

// ---------- main ----------

int main(int argc, char** argv)
{
    try {
        if (hid_init() != 0) {
            std::fprintf(stderr, "hid_init() failed\n");
            return 1;
        }

        int interface = 1;
        std::optional<std::string> serial;

        if (argc >= 2) interface = std::atoi(argv[1]);
        if (argc >= 3) serial = std::string(argv[2]);

        list_devices();

        std::printf("Открываю G102: interface=%d", interface);
        if (serial) std::printf(", serial=%s", serial->c_str());
        std::printf("\n");

        hid_device* dev = open_g102(interface, serial);
        std::printf("Открыто.\n\n");

        // 1) Ping
        bool ok = hidpp_ping(dev);

        // 2) Дополнительно можно сюда добавлять свои команды,
        //    например, запрос feature ID для подсветки:
        //
        //    hidpp_send(dev, 0x11, 0xFF, 0x00, 0x00,
        //               { 0x00, 0x80 }); // Feature ID для 0x8040
        //
        //    auto r = read_report(dev, 500);
        //    print_hex("feature id reply", r);

        hid_close(dev);
        hid_exit();

        return ok ? 0 : 2;
    }
    catch (const std::exception& e) {
        std::fprintf(stderr, "Ошибка: %s\n", e.what());
        return 1;
    }
}
